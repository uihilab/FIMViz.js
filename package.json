{
  "name": "fimviz",
  "version": "1.0.0",
  "description": "A headless flood-inundation-map visualization engine — Dataset/Storage/parse primitives, ColorScale/Legend/Stats read-models, a Layer model, and a Google Maps/Leaflet map-provider seam.",
  "type": "module",
  "module": "dist/fimviz.js",
  "types": "dist/types/package/lib.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uihilab/FIMViz.js.git"
  },
  "homepage": "https://github.com/uihilab/FIMViz.js#readme",
  "bugs": "https://github.com/uihilab/FIMViz.js/issues",
  "exports": {
    ".": {
      "types": "./dist/types/package/lib.d.ts",
      "default": "./dist/fimviz.js"
    },
    "./package.json": "./package.json",
    "./ui": {
      "types": "./dist/types/ui/index.d.ts",
      "default": "./dist/ui.js"
    },
    "./src": "./src/package/lib.js",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && webpack && npm run build:types",
    "build:types": "tsc",
    "docs:api": "typedoc",
    "docs:site": "typedoc --options typedoc.site.json",
    "site": "npm run build && npm run docs:site && node scripts/build-site.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "license": "ISC",
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.8",
    "@tmcw/togeojson": "^6.0.0",
    "@turf/turf": "^7.1.0",
    "default-passive-events": "^2.0.0",
    "gdal3.js": "^2.8.1",
    "geotiff": "^2.1.3",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "proj4": "^2.20.8",
    "sciwrid-toolkit": "file:vendor/sciwrid-toolkit-0.1.0.tgz",
    "shpjs": "^6.1.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.65.3",
    "@types/shpjs": "^3.4.7",
    "css-loader": "^7.1.4",
    "fake-indexeddb": "^6.2.5",
    "h5wasm": "^0.10.3",
    "jsdom": "^29.1.1",
    "marked": "^18.0.9",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "~5.9",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  }
}
